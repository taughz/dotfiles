# base/Containerfile

# Copyright (c) 2023 Tim Perkins

FROM ubuntu:22.04

# Set shell to Bash with better error flags
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# Ensure root user
USER root
WORKDIR /

# Make sure we don't get prompted
ARG DEBIAN_FRONTEND="noninteractive"
ARG TERM="dumb"

# Prevent DBus warning message
ENV NO_AT_BRIDGE=1

# The container has its own IPC namespace
ENV QT_X11_NO_MITSHM=1

# Install essential utilities
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gosu \
        sudo \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Install some basic utilities
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash-completion \
        bzip2 \
        ca-certificates \
        curl \
        dbus \
        dbus-x11 \
        direnv \
        faketime \
        file \
        gnome-keyring \
        gnupg \
        gzip \
        htop \
        jq \
        less \
        locales \
        lz4 \
        lzip \
        lzop \
        nano \
        openssh-client \
        p7zip-full \
        pass \
        patch \
        rsync \
        tar \
        tmux \
        tzdata \
        unzip \
        usbutils \
        xclip \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Install Mesa, so OpenGL can use the GPU
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libegl-mesa0 \
        libegl1 \
        libgl1 \
        libgl1-mesa-dri \
        libglx-mesa0 \
        mesa-utils \
    && rm -rf /var/lib/apt/lists/*

# Install tools for network debugging
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        iproute2 \
        iputils-arping \
        iputils-clockdiff \
        iputils-ping \
        iputils-tracepath \
        dnsutils \
        net-tools \
    && rm -rf /var/lib/apt/lists/*

# Set up language
ENV LANG="en_US.UTF-8"

# Set up locale
RUN locale-gen $LANG \
    && update-locale LANG=$LANG

# Git variables
ARG GIT_DEB_URL="https://ppa.launchpadcontent.net/git-core/ppa/ubuntu"
ARG GIT_DEB_DIST="jammy"
ARG GIT_DEB_COMP="main"
ARG GIT_KEY_FINGERPRINT="0xe1dd270288b4e6030699e45fa1715d88e1df1f24"
ARG GIT_KEY_URL="https://keyserver.ubuntu.com/pks/lookup?op=get&search=$GIT_KEY_FINGERPRINT"
ARG GIT_KEY_FILE="/usr/share/keyrings/git-keyring.gpg"

# Add Git repo
RUN curl -fL "$GIT_KEY_URL" | gpg --dearmor > $GIT_KEY_FILE \
    && { \
        echo "# Git Repo"; \
        echo "deb [signed-by=$GIT_KEY_FILE] $GIT_DEB_URL $GIT_DEB_DIST $GIT_DEB_COMP"; \
        echo "deb-src [signed-by=$GIT_KEY_FILE] $GIT_DEB_URL $GIT_DEB_DIST $GIT_DEB_COMP"; \
    } >> /etc/apt/sources.list.d/git.list

# GitHub CLI variables
ARG GH_DEB_URL="https://cli.github.com/packages"
ARG GH_DEB_DIST="stable"
ARG GH_DEB_COMP="main"
ARG GH_KEY_URL="https://cli.github.com/packages/githubcli-archive-keyring.gpg"
ARG GH_KEY_FILE="/usr/share/keyrings/githubcli-archive-keyring.gpg"

# Add GitHub CLI repo
RUN curl -fL -o $GH_KEY_FILE "$GH_KEY_URL" \
    && { \
        echo "# GitHub CLI Repo"; \
        echo "deb [signed-by=$GH_KEY_FILE] $GH_DEB_URL $GH_DEB_DIST $GH_DEB_COMP"; \
    } >> /etc/apt/sources.list.d/github-cli.list

# Install fundamental dev tools
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        g++ \
        gcc \
        gh \
        git \
        git-lfs \
        make \
        python-is-python3 \
        python3 \
        python3-pip \
        shellcheck \
    && rm -rf /var/lib/apt/lists/*

# Set up Git LFS for the system
RUN git lfs install --system --skip-repo

# Non-root user variables
ARG DEV_USER="dev"
ARG DEV_USER_UID=7777
ARG DEV_USER_GID=$DEV_USER_UID
ARG DEV_USER_FULLNAME=$DEV_USER
ARG DEV_USER_HOME="/home/$DEV_USER"
ARG DEV_USER_SHELL="/bin/bash"

# Persist these variables for other container layers
ENV DEV_USER=$DEV_USER
ENV DEV_USER_UID=$DEV_USER_UID
ENV DEV_USER_GID=$DEV_USER_GID
ENV DEV_USER_FULLNAME=$DEV_USER_FULLNAME
ENV DEV_USER_HOME=$DEV_USER_HOME
ENV DEV_USER_SHELL=$DEV_USER_SHELL

# Create non-root user
RUN groupadd --gid $DEV_USER_GID $DEV_USER \
    && useradd \
        --no-log-init \
        --uid $DEV_USER_UID \
        --gid $DEV_USER_GID \
        --comment "$DEV_USER_FULLNAME,,," \
        --home-dir $DEV_USER_HOME \
        --shell $DEV_USER_SHELL \
        --create-home \
        $DEV_USER \
    && usermod --append --groups sudo $DEV_USER

# Make directories in the home directory, so mounts don't create them as root
RUN install -d -m 755 -o $DEV_USER_UID -g $DEV_USER_GID \
        $DEV_USER_HOME/.bashrc.d \
        $DEV_USER_HOME/.cache \
        $DEV_USER_HOME/.config \
        $DEV_USER_HOME/.host \
        $DEV_USER_HOME/.local \
        $DEV_USER_HOME/.local/bin \
    && install -d -m 700 -o $DEV_USER_UID -g $DEV_USER_GID \
        $DEV_USER_HOME/.config/gh \
        $DEV_USER_HOME/.gnupg \
        $DEV_USER_HOME/.host/gnupg

# Add the local bin directory to the path
ENV PATH="$DEV_USER_HOME/.local/bin:$PATH"

# Never start an agent, use the host's agent through a socket
RUN echo "no-autostart" \
    | install -m 600 -o $DEV_USER_UID -g $DEV_USER_GID /dev/stdin \
        $DEV_USER_HOME/.gnupg/gpg.conf

# Set up a run directory for the user, including the X11 socket directory
RUN install -d -m 755 /run/user \
    && install -d -m 700 -o $DEV_USER_UID -g $DEV_USER_GID /run/user/$DEV_USER_UID \
    && install -d -m 1777 /tmp/.X11-unix

# Set up sudo for user
RUN echo "$DEV_USER ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers \
    && sudo -u $DEV_USER touch $DEV_USER_HOME/.sudo_as_admin_successful

# Directory for mounting volumes, to be used by other container layers
ENV VOLS_DIR="/vols"

# Directory to hold volume initialization data
ENV VOLS_INIT_DIR="$VOLS_DIR/.init"

# Directory for shell config
ENV SHELL_CONFIG_DIR="$VOLS_DIR/shell"

# Directory for entry point scripts
ENV ENTRYPOINT_DIR="/etc/entrypoint.d"

# Create those directories, the shell config belongs to the user
RUN install -d -m 755 $VOLS_DIR $VOLS_INIT_DIR $ENTRYPOINT_DIR \
    && install -d -m 755 -o $DEV_USER_UID -g $DEV_USER_GID $SHELL_CONFIG_DIR

# Modify PS1 to put a * after the hostname. This is sort of useful because it
# let's you quickly see if you are inside the container or not.
RUN sed -i 's;PS1.*\\h;&*;' /root/.bashrc $DEV_USER_HOME/.bashrc

# Add ~/.bashrc.d support to the user's ~/.bashrc
COPY --chown=root bashrcd_fragment.bash /tmp/bashrcd_fragment.bash
RUN cat /tmp/bashrcd_fragment.bash >> $DEV_USER_HOME/.bashrc

# Copy the entry point script, login shim, etc
COPY --chown=root entrypoint.sh /entrypoint.sh
COPY --chown=root entrypoint.d/fix_user.sh $ENTRYPOINT_DIR/10_fix_user.sh
COPY --chown=root entrypoint.d/login_shim.sh $ENTRYPOINT_DIR/11_login_shim.sh
COPY --chown=root entrypoint.d/shell_init.sh $ENTRYPOINT_DIR/14_shell_init.sh
COPY --chown=root entrypoint.d/dbus_init.sh $ENTRYPOINT_DIR/15_dbus_init.sh
COPY --chown=root entrypoint.d/gpg_init.sh $ENTRYPOINT_DIR/16_gpg_init.sh
COPY --chown=root entrypoint.d/xauth_init.sh $ENTRYPOINT_DIR/17_xauth_init.sh
COPY --chown=root entrypoint.d/keyring_init.sh $ENTRYPOINT_DIR/20_keyring_init.sh
COPY --chown=root entrypoint.d/gh_init.sh $ENTRYPOINT_DIR/21_gh_init.sh

# Copy the GPG setup, etc
COPY --chown=$DEV_USER bashrc.d/gpg_setup.bash $DEV_USER_HOME/.bashrc.d/10_gpg_setup.bash
COPY --chown=$DEV_USER bashrc.d/direnv_setup.bash $DEV_USER_HOME/.bashrc.d/11_direnv_setup.bash

# Here we set the entry point to the main entry point script. This script in
# turn execs a chain of other entry points. This allows other images to layer
# their own entry points onto the original entry point.
ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]

# By default just run Bash
CMD ["/bin/bash"]

# Switch to non-root user
USER $DEV_USER
WORKDIR $DEV_USER_HOME
